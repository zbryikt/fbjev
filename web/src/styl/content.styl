// 注入 FB 頁面的樣式。全部限定在 .fbjev-* 底下, 不碰 FB 自己的節點。
.fbjev-badge
  position: absolute
  top: 8px
  right: 8px
  z-index: 100
  display: flex
  gap: 3px
  align-items: center
  padding: 2px 6px
  border-radius: 10px
  background-color: rgba(255,255,255,.92)
  box-shadow: 0 1px 4px rgba(0,0,0,.2)
  font-size: 10px
  line-height: 15px
  font-family: system-ui, sans-serif
  color: #444
  pointer-events: auto
  cursor: pointer

  &[data-state="pending"]
    opacity: .6

  &[data-state="error"]
    color: #c00

.fbjev-chip
  padding: 0 4px
  border-radius: 6px
  background-color: #eee
  white-space: nowrap

  &[data-hit="1"]
    background-color: #d33
    color: #fff
    font-weight: 600

  &[data-dim="ad"][data-hit="1"]
    background-color: #e08a00

  &[data-dim="ai"][data-hit="1"]
    background-color: #2a6cd4


// 命中後把卡片收掉。只加 class, 不動 FB 的節點結構或 inline style。
// 截到 72px 大約就是頭像 + 發布者 + 時間那一行, 剛好留下「誰發的」。
.fbjev-folded
  position: relative
  max-height: 72px !important
  overflow: hidden !important
  opacity: .32
  transition: opacity .15s ease

  &:hover
    opacity: .6

  // 收合時把標記縮成一小條, 才不會蓋住發布者名字
  .fbjev-badge
    top: 4px
    right: 4px
    transform: scale(.85)
    transform-origin: top right


.fbjev-chip[data-dim="hate"][data-hit="1"]
  background-color: #8b1a1a

.fbjev-chip[data-dim="noob"][data-hit="1"]
  background-color: #6b6b8b
