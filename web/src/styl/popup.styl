.fbjev-popup
  width: 300px
  margin: 0
  padding: 12px
  font-family: system-ui, sans-serif
  font-size: 13px
  color: #222

  h1
    margin: 0
    font-size: 15px

  h2
    margin: 12px 0 4px
    font-size: 12px
    color: #666

  .hd
    display: flex
    justify-content: space-between
    align-items: center

  .fields
    display: flex
    flex-direction: column
    gap: 8px
    margin-top: 12px

    label
      display: flex
      flex-direction: column
      gap: 3px

      > span
        color: #666
        font-size: 11px

    input[type="text"], input[type="password"], select
      padding: 4px 6px
      border: 1px solid #ccc
      border-radius: 4px
      font-size: 12px

  .sw
    flex-direction: row !important
    align-items: center
    gap: 6px

  .stats
    ul
      margin: 0
      padding-left: 18px

    b
      margin: 0 3px

    button
      margin-top: 8px
      padding: 3px 8px
      border: 1px solid #ccc
      border-radius: 4px
      background-color: #f6f6f6
      cursor: pointer

  .msg
    min-height: 16px
    margin: 8px 0 0
    color: #2a6cd4
    font-size: 11px
